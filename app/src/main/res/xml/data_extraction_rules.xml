<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the Gemini API key out of cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/noc_ai.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/noc_ai.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
